FROM python:3.11-slim

WORKDIR /app

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Install dependencies to /opt/venv (outside /app to avoid volume mount overwrite)
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-cache
ENV PATH="/opt/venv/bin:$PATH"

COPY . .

ENV BACKEND_PORT=8080
EXPOSE ${BACKEND_PORT}

CMD uvicorn tour_meeting.backend.api:app --host 0.0.0.0 --port ${BACKEND_PORT} --log-level warning